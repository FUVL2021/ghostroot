<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.fuxi.ghostroot"
    android:versionCode="2"
    android:versionName="1.1">

    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <application
        android:name=".StubApp"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:extractNativeLibs="true"
        android:allowBackup="false">

        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />

        <activity
            android:name=".DisclaimerActivity"
            android:label="@string/app_name"
            android:theme="@style/AppTheme"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:theme="@style/AppTheme"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".ShellTerminalActivity"
            android:theme="@style/AppTheme"
            android:exported="false" />

        <!-- Shizuku 官方接入点在：Shizuku 服务端(ADB模式)会反向 call 本 App 的
             这个 provider（method=sendBinder）把 binder 推进来。
             authority 必须是 <包名>.shizuku，且 exported=true / multiprocess=false。 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.fuxi.ghostroot.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:enabled="true" />
    </application>
</manifest>